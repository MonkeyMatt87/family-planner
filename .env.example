# Copy to .env (the installers do this for you) and fill in what you use.

# Your time zone: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=America/Toronto

# Port for the planner on your network (http://<server>:8080)
PLANNER_PORT=8080

# Extras to run, comma separated: tunnel, https, homelab (see docker-compose.yml)
COMPOSE_PROFILES=

# tunnel: Cloudflare Zero Trust → Networks → Tunnels → your tunnel → the long token in the install command.
# Public hostname in Cloudflare: family.<your domain> → HTTP → planner:8080
CLOUDFLARE_TUNNEL_TOKEN=

# https: the home address (e.g. home.example.com, DNS-only A record → this server's home IP), and a
# Cloudflare API token from the "Edit zone DNS" template for that domain.
HOME_DOMAIN=
CLOUDFLARE_DNS_TOKEN=

# homelab: the network card netmon scans (eth0 in a Proxmox LXC)
NETMON_IFACE=eth0
